# File: .gitignore
# Description:
#   - Specifies intentionally untracked files to ignore.
#   - Includes Ansible temporary files, Python virtual environments, and IDE-specific files.
#   - Ensures sensitive files are not committed to version control.
# Author: Andrii Sadovskyi <andrii.sadovskyi@gmail.com>

# Ansible artifacts
.ansible/
.ansible_tmp/
.ansible_facts_cache/
fact_caching/
.fact_cache/
*.retry

# Secrets and local overrides
.vault_pass
.vault_password_file
*.vault
*.vault_pass
*.key
*.pem
*.crt
*.env
*.env.*
inventories/**/group_vars/**/vault.yml

# Python artifacts
.venv/
venv/
__pycache__/
*.pyc

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and scratch files
*.log
*.tmp

