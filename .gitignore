# File: .gitignore
# Description:
#   - Specifies intentionally untracked files to ignore.
#   - Includes Ansible temporary files, Python virtual environments, and IDE-specific files.
#   - Ensures sensitive files are not committed to version control.
# Author: Andrii Sadovskyi <andrii.sadovskyi@gmail.com>

# Ansible temporary files
.ansible/
*.retry
*.log
*.tmp
.vault_pass
.ansible_tmp/
fact_caching/

# Python virtual environment
.venv/
venv/

# Editor/IDE specific files
.idea/
.vscode/

# OS generated files
.DS_Store
Thumbs.db

# Sensitive files (ensure these are never committed)
*.vault
*.key
*.pem
*.crt
*.env