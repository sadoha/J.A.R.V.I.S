[Unit]
Description=Hermes Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ hermes_service_user }}
Group={{ hermes_service_group }}
EnvironmentFile=/etc/default/hermes-agent
WorkingDirectory={{ hermes_install_dir }}/current
ExecStart={{ hermes_exec_start }}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ReadWritePaths={{ hermes_data_dir }} {{ hermes_log_dir }}

[Install]
WantedBy=multi-user.target
