# Description:
#   - Docker Compose project for the Hermes web dashboard.
#   - Runs the dashboard exclusively inside the Hermes Docker image.
# Docs: https://hermes-agent.nousresearch.com/docs/user-guide/docker
# Author: Andrii Sadovskyi <andrii.sadovskyi@gmail.com>

services:
  {{ hermes_web_dashboard_container_name }}:
    image: "{{ hermes_web_dashboard_image }}"
    container_name: "{{ hermes_web_dashboard_container_name }}"
    restart: unless-stopped
    network_mode: host
    environment:
      HOME: /opt/hermes-agent
      HERMES_HOME: /opt/hermes-agent/.hermes
      HERMES_DASHBOARD: "1"
      HERMES_DASHBOARD_HOST: "{{ hermes_web_dashboard_bind_host }}"
      HERMES_DASHBOARD_PORT: "{{ hermes_web_dashboard_bind_port }}"
      HERMES_DASHBOARD_BASIC_AUTH_USERNAME: "{{ hermes_web_dashboard_basic_auth_username }}"
      HERMES_DASHBOARD_BASIC_AUTH_PASSWORD: "{{ hermes_web_dashboard_basic_auth_password }}"
      HERMES_DASHBOARD_BASIC_AUTH_SECRET: "{{ hermes_web_dashboard_basic_auth_secret }}"
    volumes:
      - "{{ hermes_agent_home_dir }}:/opt/hermes-agent/.hermes"
    command:
      - gateway
      - run
    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS http://127.0.0.1:{{ hermes_web_dashboard_bind_port }}/health >/dev/null
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 20s